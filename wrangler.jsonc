{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bsw",
	// No newer than the workerd that @cloudflare/vite-plugin bundles supports, or `npm run dev` refuses to start.
	"compatibility_date": "2026-10-19",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true,
		"traces": { "enabled": true, "head_sampling_rate": 0.1 },
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
}
