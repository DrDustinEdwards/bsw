{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bsw",
	"compatibility_date": "2026-10-23",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true,
		"traces": { "enabled": true, "head_sampling_rate": 0.1 },
		"logs": { "enabled": true, "head_sampling_rate": 1 }
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	]
}
