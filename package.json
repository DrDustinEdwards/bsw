{
  "name": "bsw",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run headers && react-router build",
    "headers": "site-runtime-headers --site bsw --out public/_headers --header \"tdm-reservation: 1\" --header \"X-Robots-Tag: noindex\"",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "test": "node --test \"test/*.test.ts\"",
    "check:migrations": "devkit-migrations drizzle",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:migrate": "wrangler d1 migrations apply bsw --local",
    "db:migrate:prod": "wrangler d1 migrations apply bsw --remote",
    "postinstall": "devkit-bootstrap",
    "bloat": "devkit-no-bloat",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.63.7",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.16.3",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.46.1",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.173.1",
    "@fontsource-variable/open-sans": "5.3.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.164.2",
    "hast-util-from-html": "2.1.0",
    "hast-util-to-mdast": "10.1.3",
    "hast-util-to-string": "3.0.1",
    "hastscript": "9.0.3",
    "htmlparser2": "12.0.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.55.7",
    "@fontsource/open-sans": "5.3.0",
    "@react-router/dev": "8.5.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "takumi-js": "2.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.164.0"
  },
  "overrides": {
    "fflate": "0.8.3"
  }
}
