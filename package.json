{
  "name": "bsw",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "devkit-bootstrap --types-only && react-router typegen && tsc -b",
    "test": "node --test \"test/*.test.ts\"",
    "check:migrations": "devkit-migrations drizzle",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vite preview",
    "cf-typegen": "devkit-bootstrap --types-only",
    "db:migrate": "wrangler d1 migrations apply bsw --local",
    "db:migrate:prod": "wrangler d1 migrations apply bsw --remote",
    "postinstall": "devkit-bootstrap"
  },
  "dependencies": {
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.24.0",
    "@dustinedwards/d1-dump": "github:DrDustinEdwards/d1-dump#v0.9.0",
    "@dustinedwards/site-api": "github:DrDustinEdwards/site-api#v0.18.0",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.60.0",
    "@fontsource-variable/open-sans": "5.3.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.55.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.22",
    "@fontsource/open-sans": "5.3.0",
    "@react-router/dev": "8.5.1",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "satori": "0.33.5",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "wrangler": "4.151.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  }
}
